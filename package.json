{
  "name": "project-ronin",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous AI-Powered Black-Box API Security Testing Platform — Monorepo Root",
  "scripts": {
    "dev:frontend": "npm --prefix ./Ronin-signup run dev",
    "dev:backend": "npm --prefix ./backend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix ./Ronin-signup run build",
    "install:all": "npm --prefix ./Ronin-signup install && npm --prefix ./backend install",
    "lint:frontend": "npm --prefix ./Ronin-signup run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
